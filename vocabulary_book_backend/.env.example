# 复制为 .env 后填写，.env 已被 .gitignore 忽略，切勿提交真实密钥
ENV=development
DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_DATABASE=sanfendi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=30

# 阿里云短信
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_API_KEY=
SMS_API_SECRET=

# 微信小程序登录（留空则关闭微信一键登录，仅短信登录可用）
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 微信开放平台「网站应用」扫码登录（Chrome 扩展登录；留空则扩展无法微信登录）
# 需在 open.weixin.qq.com 创建网站应用并通过审核，回调域名须与 REDIRECT_URI 一致
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=https://api.your-domain.com/api/user/login/wechat/callback/

# 词典查询（可选，默认免费 Free Dictionary API；置空关闭释义查询）
DICTIONARY_API_BASE=https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_TIMEOUT=5

# CORS 白名单（逗号分隔，可配置多个扩展源）
CORS_ORIGINS=chrome-extension://bpcmapeoloepbomiddaidikkbbaeodjn
