.stats {
  display: flex;
  align-items: center;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: #eef0f3;
}

.search-card {
  padding: 20rpx 24rpx;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.add-input {
  flex: 1;
}

.btn-add {
  flex-shrink: 0;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 12rpx;
}

.word-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.word-text {
  font-size: 32rpx;
  font-weight: 500;
  word-break: break-all;
}

.word-meta {
  flex-shrink: 0;
  margin-left: 24rpx;
}

.list-footer {
  text-align: center;
  padding: 24rpx 0 48rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b6bcc4;
}
