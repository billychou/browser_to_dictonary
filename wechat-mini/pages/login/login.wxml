<view class="login">
  <view class="logo">词</view>
  <view class="title">生词本</view>
  <view class="subtitle">浏览器划词收集 · 随时随地复习</view>

  <view class="form">
    <button
      class="btn-primary wx-btn"
      loading="{{wxLoading}}"
      disabled="{{wxLoading}}"
      bindtap="wechatLogin"
    >微信一键登录</button>

    <view class="divider">
      <view class="divider-line"></view>
      <view class="divider-text">或使用手机号登录</view>
      <view class="divider-line"></view>
    </view>

    <input
      class="input"
      type="number"
      maxlength="11"
      placeholder="手机号"
      placeholder-class="ph"
      value="{{phone}}"
      bindinput="onPhoneInput"
    />
    <view class="code-row">
      <input
        class="input code-input"
        type="number"
        maxlength="6"
        placeholder="短信验证码"
        placeholder-class="ph"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <view
        class="code-btn {{countdown > 0 ? 'code-btn-disabled' : ''}}"
        bindtap="sendCode"
      >{{countdown > 0 ? countdown + 's 后重发' : '获取验证码'}}</view>
    </view>
    <button
      class="btn-plain submit-btn"
      disabled="{{loading}}"
      bindtap="submit"
    >{{loading ? '登录中…' : '登录 / 注册'}}</button>
    <view class="error" wx:if="{{message}}">{{message}}</view>
  </view>

  <view class="tip muted">与浏览器插件共用同一账号，词汇数据云端同步</view>
</view>
