.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  margin-left: 28rpx;
  overflow: hidden;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  text-align: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.grid-num {
  font-size: 44rpx;
  font-weight: 600;
}

.grid-label {
  margin-top: 4rpx;
}

.api-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.api-input {
  flex: 1;
  font-size: 26rpx;
}

.api-save {
  flex-shrink: 0;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 12rpx;
}

.api-tip {
  margin-top: 16rpx;
  line-height: 1.6;
}

.about-text {
  line-height: 1.8;
}

.logout-btn {
  color: #fa5151;
  border-color: #ffd9d9;
  margin-top: 8rpx;
}
